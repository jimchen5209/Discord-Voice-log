generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ServerConfig {
  // The scope of the guild (see Platform/Scope.ts); no defaults, so every write names its scope
  platform            String
  instanceId          String
  // The guild id within the scope
  serverID            String
  lang                String   @default("en_US")
  channelID           String   @default("")
  lastVoiceChannel    String   @default("")
  currentVoiceChannel String   @default("")
  
  // TTS Settings
  ttsEnabled          Boolean  @default(false)
  ttsMessageLang      String   @default("en_US")
  ttsProvider         String   @default("google-cloud")
  ttsVoiceLang        String   @default("en-US")
  ttsVoiceName        String   @default("en-US-Wavenet-A")

  @@id([platform, instanceId, serverID])
  @@map("serverConfig")
}

